{
  "name": "gherkin-specification-skills",
  "version": "2.0.1",
  "description": "Agent Skills that teach behaviour-driven specification with Gherkin, for Claude Code",
  "license": "MIT",
  "author": "Yutthana Siphuengchai",
  "homepage": "https://github.com/yutna/gherkin-specification-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yutna/gherkin-specification-skills.git"
  },
  "keywords": [
    "gherkin",
    "bdd",
    "cucumber",
    "agent-skills",
    "claude-code",
    "specification-by-example",
    "living-documentation"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#SOURCES.md\" \"#.claude\"",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:gherkin": "node scripts/validate-gherkin.mjs",
    "test": "npm run lint:md && npm run validate:skills && npm run validate:gherkin"
  },
  "devDependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "markdownlint-cli2": "0.23.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "smol-toml": "1.7.1"
  }
}
